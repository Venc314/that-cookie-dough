{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "pages/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "scripts/**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/index.html"
    },
    {
      "src": "/home",
      "dest": "/index.html"
    },
    {
      "src": "/homepage",
      "dest": "/pages/homepage.html"
    },
    {
      "src": "/homepage.html",
      "dest": "/pages/homepage.html"
    },
    {
      "src": "/pages/homepage",
      "dest": "/pages/homepage.html"
    },
    {
      "src": "/pages/homepage.html",
      "dest": "/pages/homepage.html"
    },
    {
      "src": "/product",
      "dest": "/pages/product.html"
    },
    {
      "src": "/product.html",
      "dest": "/pages/product.html"
    },
    {
      "src": "/pages/product",
      "dest": "/pages/product.html"
    },
    {
      "src": "/pages/product.html",
      "dest": "/pages/product.html"
    },
    {
      "src": "/product2",
      "dest": "/pages/product2.html"
    },
    {
      "src": "/product2.html",
      "dest": "/pages/product2.html"
    },
    {
      "src": "/pages/product2",
      "dest": "/pages/product2.html"
    },
    {
      "src": "/pages/product2.html",
      "dest": "/pages/product2.html"
    },
    {
      "src": "/productinfo",
      "dest": "/pages/productinfo.html"
    },
    {
      "src": "/productinfo.html",
      "dest": "/pages/productinfo.html"
    },
    {
      "src": "/pages/productinfo",
      "dest": "/pages/productinfo.html"
    },
    {
      "src": "/pages/productinfo.html",
      "dest": "/pages/productinfo.html"
    },
    {
      "src": "/productinfo2",
      "dest": "/pages/productinfo2.html"
    },
    {
      "src": "/productinfo2.html",
      "dest": "/pages/productinfo2.html"
    },
    {
      "src": "/pages/productinfo2",
      "dest": "/pages/productinfo2.html"
    },
    {
      "src": "/pages/productinfo2.html",
      "dest": "/pages/productinfo2.html"
    },
    {
      "src": "/styles/(.*)",
      "dest": "/styles/$1"
    },
    {
      "src": "/scripts/(.*)",
      "dest": "/scripts/$1"
    },
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
